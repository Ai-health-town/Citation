# Copy these settings into Streamlit Cloud > App settings > Secrets.
# Locally, copy this file to .streamlit/secrets.toml (which is gitignored).
AI_API_KEY = "YOUR_STANDARD_ZAI_API_KEY"
AI_BASE_URL = "https://api.z.ai/api/paas/v4"
AI_MODEL = "glm-4.7"

# Optional: require a shared password before the app opens.
# APP_PASSWORD = "choose-a-long-private-password"
